{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ascendop.retrieval-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "operator_id", "query", "created_at", "index_generation", "filters", "results", "selected_technique_ids", "disposition", "rationale"],
  "properties": {
    "schema": {"const": "ascendop.retrieval-decision.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "index_generation": {"type": "string", "minLength": 1},
    "filters": {"type": "object"},
    "results": {"type": "array", "items": {"type": "object", "required": ["technique_id", "rank"], "properties": {"technique_id": {"type": "string", "minLength": 1}, "rank": {"type": "integer", "minimum": 1}, "bm25_score": {"type": ["number", "null"]}, "semantic_score": {"type": ["number", "null"]}, "rrf_score": {"type": ["number", "null"]}}, "additionalProperties": false}},
    "selected_technique_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "disposition": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1}
  }
}
