{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ascendop.official-problem-snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "campaign_id", "operator_id", "display_name", "source_url", "submit_url", "ranking_url", "captured_at", "environment", "problem", "project", "page_digests"],
  "properties": {
    "schema": {"const": "ascendop.official-problem-snapshot.v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "submit_url": {"type": "string", "minLength": 1},
    "ranking_url": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soc", "cann"],
      "properties": {
        "soc": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cann": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["track", "summary", "constraints"],
      "properties": {
        "track": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "constraints": {"type": "array"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "digest", "files"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "page_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
