[Unit]
Description=GitPartner adaptive client (B)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ascendop
WorkingDirectory=/opt/ascendop/git-partner
ExecStart=/usr/bin/env bash -lc 'cd /opt/ascendop/git-partner && export PYTHONPATH=/opt/ascendop/git-partner/src && NETWORK_EXPORTS="$(python3 -m limited_remote_partner.core.login_environment shell-exports --config configs/partner.json)" && if [ -n "$NETWORK_EXPORTS" ]; then eval "$NETWORK_EXPORTS"; fi && python3 -m limited_remote_partner.core.login_environment report --config configs/partner.json && exec python3 -m limited_remote_partner.cli.partner --config configs/partner.json --role client --allow-scp-relay'
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/ascendop /tmp /var/tmp

[Install]
WantedBy=multi-user.target
