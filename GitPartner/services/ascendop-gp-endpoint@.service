[Unit]
Description=AscendOP GP endpoint %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/ascendop/endpoints/%i.env
ExecStart=/usr/bin/env bash /workspace/AscendOP/ascend-git-partner/scripts/run_gitpartner_endpoint_service.sh
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/workspace/AscendOP /tmp /var/tmp

[Install]
WantedBy=multi-user.target
