{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ascendop.standing-submission-policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "campaign_id", "authorized_by", "issued_at", "expires_at", "rules_generation", "enabled", "operator_ids", "limits", "gate"],
  "properties": {
    "schema": {"const": "ascendop.standing-submission-policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "rules_generation": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "operator_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_submissions_per_operator_per_day", "max_pending_per_operator", "one_submission_per_digest", "require_terminal_before_next"],
      "properties": {
        "max_submissions_per_operator_per_day": {"type": "integer", "minimum": 1},
        "max_pending_per_operator": {"type": "integer", "minimum": 1},
        "one_submission_per_digest": {"type": "boolean"},
        "require_terminal_before_next": {"type": "boolean"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_true"],
      "properties": {
        "required_true": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
