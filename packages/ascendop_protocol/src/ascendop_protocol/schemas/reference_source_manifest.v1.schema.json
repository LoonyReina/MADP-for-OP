{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ascendop.reference-source-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_id", "title", "source_type", "url", "revision", "digest", "captured_at", "artifacts", "applicability"],
  "properties": {
    "schema": {"const": "ascendop.reference-source-manifest.v1"},
    "source_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "url": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "applicability": {"type": "object"}
  }
}
